# Copy to .env.local and fill in. Never commit .env.local.

# 32+ random characters, used to sign cookies.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=

# Used ONCE: the first time someone signs in with these and there are no admins yet,
# that account becomes the super admin. After that, manage everyone in Admins and access.
ADMIN_EMAIL=you@doubtster.com
ADMIN_PASSWORD=change-me-to-a-long-random-password

# Shared secret your app sends to /api/hooks/* as "Authorization: Bearer <HOOK_SECRET>"
HOOK_SECRET=

# Optional: where the dev JSON store lives (default .data/admin.json)
# DATA_FILE=
